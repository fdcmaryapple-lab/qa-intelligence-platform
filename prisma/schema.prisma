// QA Intelligence Platform — Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A person who can sign in to the platform.
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String?
  image         String?
  platformRole  PlatformRole @default(MEMBER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   ProjectMember[]
  auditLogs     AuditLog[]
  requirements  Requirement[]
  accounts      Account[]
  sessions      Session[]
  testCases     TestCase[]
  aiGenerations AiGeneration[]
  bugs          Bug[]

  @@map("users")
}

enum PlatformRole {
  MEMBER
  PLATFORM_ADMIN
}

model Project {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     ProjectMember[]
  auditLogs   AuditLog[]
  requirements Requirement[]
  testCases   TestCase[]
  aiGenerations AiGeneration[]
  bugs        Bug[]

  @@index([slug])
  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(cuid())
  userId    String
  projectId String
  role      ProjectRole @default(VIEWER)
  createdAt DateTime    @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
  @@map("project_members")
}

enum ProjectRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String
  metadata   Json?
  projectId  String?
  createdAt  DateTime @default(now())

  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model Requirement {
  id          String              @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      RequirementStatus   @default(DRAFT)
  priority    RequirementPriority @default(MEDIUM)
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  testCases   TestCase[]

  @@index([projectId, status])
  @@map("requirements")
}

enum RequirementStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
}

enum RequirementPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// A single test case, optionally traced back to the requirement it
/// covers. Bug (Phase 5) can optionally trace back to the test case that
/// surfaced it.
model TestCase {
  id             String        @id @default(cuid())
  projectId      String
  requirementId  String?
  title          String
  description    String?
  preconditions  String?
  steps          String[]
  expectedResult String?
  type           TestCaseType   @default(FUNCTIONAL)
  priority       RequirementPriority @default(MEDIUM)
  reviewStatus   ReviewStatus   @default(DRAFT)
  aiGenerationId String?
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement  Requirement?  @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  createdBy    User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  aiGeneration AiGeneration? @relation(fields: [aiGenerationId], references: [id], onDelete: SetNull)
  bugs         Bug[]

  @@index([projectId])
  @@index([requirementId])
  @@map("test_cases")
}

enum TestCaseType {
  FUNCTIONAL
  NEGATIVE
  BOUNDARY
  EDGE
  SECURITY
  REGRESSION
}

enum ReviewStatus {
  DRAFT
  ACCEPTED
  EDITED
  REJECTED
}

model AiGeneration {
  id            String   @id @default(cuid())
  targetType    String
  promptVersion String
  model         String
  inputTokens   Int?
  outputTokens  Int?
  rawResponse   Json
  status        String
  createdById   String
  projectId     String
  createdAt     DateTime @default(now())

  createdBy User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCases TestCase[]
  bugs      Bug[]

  @@index([projectId, createdAt])
  @@map("ai_generations")
}

/// A bug report, optionally traced back to the test case that surfaced
/// it. `status` tracks the bug's own lifecycle independently of
/// reviewStatus, which only tracks whether AI-drafted content is vetted.
model Bug {
  id               String              @id @default(cuid())
  projectId        String
  testCaseId       String?
  title            String
  description      String?
  preconditions    String?
  stepsToReproduce String[]
  expectedResult   String?
  actualResult     String?
  severity         RequirementPriority @default(MEDIUM)
  priority         RequirementPriority @default(MEDIUM)
  status           BugStatus           @default(OPEN)
  reviewStatus     ReviewStatus        @default(DRAFT)
  aiGenerationId   String?
  createdById      String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCase     TestCase?     @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  createdBy    User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  aiGeneration AiGeneration? @relation(fields: [aiGenerationId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([testCaseId])
  @@map("bugs")
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  WONT_FIX
}
