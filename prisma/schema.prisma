// QA Intelligence Platform — Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A person who can sign in to the platform.
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String?
  image         String?
  platformRole  PlatformRole @default(MEMBER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   ProjectMember[]
  auditLogs     AuditLog[]
  requirements  Requirement[]
  accounts      Account[]
  sessions      Session[]
  testCases     TestCase[]
  aiGenerations AiGeneration[]
  bugs          Bug[]
  apiRequests   ApiRequest[]
  apiExecutions ApiRequestExecution[]

  @@map("users")
}

enum PlatformRole {
  MEMBER
  PLATFORM_ADMIN
}

model Project {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     ProjectMember[]
  auditLogs   AuditLog[]
  requirements Requirement[]
  testCases   TestCase[]
  aiGenerations AiGeneration[]
  bugs        Bug[]
  apiRequests ApiRequest[]
  apiRequestExecutions ApiRequestExecution[]

  @@index([slug])
  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(cuid())
  userId    String
  projectId String
  role      ProjectRole @default(VIEWER)
  createdAt DateTime    @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
  @@map("project_members")
}

enum ProjectRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String
  metadata   Json?
  projectId  String?
  createdAt  DateTime @default(now())

  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model Requirement {
  id          String              @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      RequirementStatus   @default(DRAFT)
  priority    RequirementPriority @default(MEDIUM)
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  testCases   TestCase[]

  @@index([projectId, status])
  @@map("requirements")
}

enum RequirementStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
}

enum RequirementPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model TestCase {
  id             String        @id @default(cuid())
  projectId      String
  requirementId  String?
  title          String
  description    String?
  preconditions  String?
  steps          String[]
  expectedResult String?
  type           TestCaseType   @default(FUNCTIONAL)
  priority       RequirementPriority @default(MEDIUM)
  reviewStatus   ReviewStatus   @default(DRAFT)
  aiGenerationId String?
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement  Requirement?  @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  createdBy    User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  aiGeneration AiGeneration? @relation(fields: [aiGenerationId], references: [id], onDelete: SetNull)
  bugs         Bug[]

  @@index([projectId])
  @@index([requirementId])
  @@map("test_cases")
}

enum TestCaseType {
  FUNCTIONAL
  NEGATIVE
  BOUNDARY
  EDGE
  SECURITY
  REGRESSION
}

enum ReviewStatus {
  DRAFT
  ACCEPTED
  EDITED
  REJECTED
}

model AiGeneration {
  id            String   @id @default(cuid())
  targetType    String
  promptVersion String
  model         String
  inputTokens   Int?
  outputTokens  Int?
  rawResponse   Json
  status        String
  createdById   String
  projectId     String
  createdAt     DateTime @default(now())

  createdBy User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCases TestCase[]
  bugs      Bug[]

  @@index([projectId, createdAt])
  @@map("ai_generations")
}

model Bug {
  id               String              @id @default(cuid())
  projectId        String
  testCaseId       String?
  title            String
  description      String?
  preconditions    String?
  stepsToReproduce String[]
  expectedResult   String?
  actualResult     String?
  severity         RequirementPriority @default(MEDIUM)
  priority         RequirementPriority @default(MEDIUM)
  status           BugStatus           @default(OPEN)
  reviewStatus     ReviewStatus        @default(DRAFT)
  aiGenerationId   String?
  createdById      String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCase     TestCase?     @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  createdBy    User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  aiGeneration AiGeneration? @relation(fields: [aiGenerationId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([testCaseId])
  @@map("bugs")
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  WONT_FIX
}

// ─────────────────────────────────────────────────────────────
// Phase 6: API Testing Workspace.
//
// Requests are executed server-side (see server/http/execute-request.ts)
// so they work regardless of the target API's CORS policy and can reach
// internal/local URLs — the actual point of a QA tool testing your own
// APIs. That does mean the server makes outbound requests to URLs the
// user supplies, which is a real SSRF consideration in a multi-tenant
// setting; server/http/ssrf-guard.ts blocks the one genuinely dangerous
// class of target (cloud metadata endpoints) while deliberately still
// allowing localhost/private IPs, since testing local dev APIs is core
// to this feature. See that file's comments for exactly what is and
// isn't covered — it is hostname/IP-literal checking, not full
// DNS-resolution verification, so it does not defend against a
// DNS-rebinding attack. Fine for a single-user local tool; would need
// hardening before any multi-tenant deployment.
//
// Execution history is fully captured in ApiRequestExecution from day
// one, even though the UI this phase only surfaces the most recent
// result inline on each request's card — a dedicated history view is a
// pure UI addition on top of data that already exists, not a schema
// change, whenever that's worth building.
// ─────────────────────────────────────────────────────────────

model ApiRequest {
  id          String     @id @default(cuid())
  projectId   String
  name        String
  method      HttpMethod @default(GET)
  url         String
  headers     Json       @default("[]")
  queryParams Json       @default("[]")
  bodyType    ApiBodyType @default(NONE)
  body        String?
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  assertions ApiAssertion[]
  executions ApiRequestExecution[]

  @@index([projectId])
  @@map("api_requests")
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
  OPTIONS
}

enum ApiBodyType {
  NONE
  JSON
  TEXT
  FORM
}

model ApiAssertion {
  id           String         @id @default(cuid())
  apiRequestId String
  type         AssertionType
  jsonPath     String?
  expected     String
  createdAt    DateTime       @default(now())

  apiRequest ApiRequest @relation(fields: [apiRequestId], references: [id], onDelete: Cascade)

  @@index([apiRequestId])
  @@map("api_assertions")
}

enum AssertionType {
  STATUS_EQUALS
  BODY_CONTAINS
  JSON_PATH_EQUALS
}

model ApiRequestExecution {
  id              String          @id @default(cuid())
  apiRequestId    String
  projectId       String
  executedById    String
  requestSnapshot Json
  responseStatus  Int?
  responseHeaders Json?
  responseBody    String?
  responseTruncated Boolean       @default(false)
  durationMs      Int?
  error           String?
  assertionResults Json?
  result          ExecutionResult
  createdAt       DateTime        @default(now())

  apiRequest ApiRequest @relation(fields: [apiRequestId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executedBy User       @relation(fields: [executedById], references: [id], onDelete: Restrict)

  @@index([apiRequestId, createdAt])
  @@map("api_request_executions")
}

enum ExecutionResult {
  PASS
  FAIL
  ERROR
}
