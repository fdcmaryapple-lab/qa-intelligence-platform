generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String?
  image         String?
  platformRole  PlatformRole @default(MEMBER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   ProjectMember[]
  auditLogs     AuditLog[]
  requirements  Requirement[]
  accounts      Account[]
  sessions      Session[]
  testCases     TestCase[]
  aiGenerations AiGeneration[]
  bugs          Bug[]
  apiRequests   ApiRequest[]
  apiExecutions ApiRequestExecution[]
  automationScripts AutomationScript[]
  testRuns TestRun[]
  testRunResultsExecuted TestRunResult[]
  screenshotBaselines ScreenshotBaseline[]
  screenshotComparisons ScreenshotComparison[]

  @@map("users")
}

enum PlatformRole {
  MEMBER
  PLATFORM_ADMIN
}

model Project {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     ProjectMember[]
  auditLogs   AuditLog[]
  requirements Requirement[]
  testCases   TestCase[]
  aiGenerations AiGeneration[]
  bugs        Bug[]
  apiRequests ApiRequest[]
  apiRequestExecutions ApiRequestExecution[]
  automationScripts AutomationScript[]
  testRuns TestRun[]
  screenshotBaselines ScreenshotBaseline[]
  screenshotComparisons ScreenshotComparison[]

  @@index([slug])
  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(cuid())
  userId    String
  projectId String
  role      ProjectRole @default(VIEWER)
  createdAt DateTime    @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
  @@map("project_members")
}

enum ProjectRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String
  metadata   Json?
  projectId  String?
  createdAt  DateTime @default(now())

  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model Requirement {
  id          String              @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      RequirementStatus   @default(DRAFT)
  priority    RequirementPriority @default(MEDIUM)
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  testCases   TestCase[]

  @@index([projectId, status])
  @@map("requirements")
}

enum RequirementStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
}

enum RequirementPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model TestCase {
  id             String        @id @default(cuid())
  projectId      String
  requirementId  String?
  title          String
  description    String?
  preconditions  String?
  steps          String[]
  expectedResult String?
  type           TestCaseType   @default(FUNCTIONAL)
  priority       RequirementPriority @default(MEDIUM)
  reviewStatus   ReviewStatus   @default(DRAFT)
  aiGenerationId String?
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement  Requirement?  @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  createdBy    User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  aiGeneration AiGeneration? @relation(fields: [aiGenerationId], references: [id], onDelete: SetNull)
  bugs         Bug[]
  automationScripts AutomationScript[]
  testRunResults TestRunResult[]

  @@index([projectId])
  @@index([requirementId])
  @@map("test_cases")
}

enum TestCaseType {
  FUNCTIONAL
  NEGATIVE
  BOUNDARY
  EDGE
  SECURITY
  REGRESSION
}

enum ReviewStatus {
  DRAFT
  ACCEPTED
  EDITED
  REJECTED
}

model AiGeneration {
  id            String   @id @default(cuid())
  targetType    String
  promptVersion String
  model         String
  inputTokens   Int?
  outputTokens  Int?
  rawResponse   Json
  status        String
  createdById   String
  projectId     String
  createdAt     DateTime @default(now())

  createdBy User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCases TestCase[]
  bugs      Bug[]
  automationScripts AutomationScript[]

  @@index([projectId, createdAt])
  @@map("ai_generations")
}

model Bug {
  id               String              @id @default(cuid())
  projectId        String
  testCaseId       String?
  title            String
  description      String?
  preconditions    String?
  stepsToReproduce String[]
  expectedResult   String?
  actualResult     String?
  severity         RequirementPriority @default(MEDIUM)
  priority         RequirementPriority @default(MEDIUM)
  status           BugStatus           @default(OPEN)
  reviewStatus     ReviewStatus        @default(DRAFT)
  aiGenerationId   String?
  createdById      String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCase     TestCase?     @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  createdBy    User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  aiGeneration AiGeneration? @relation(fields: [aiGenerationId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([testCaseId])
  @@map("bugs")
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  WONT_FIX
}

model ApiRequest {
  id          String     @id @default(cuid())
  projectId   String
  name        String
  method      HttpMethod @default(GET)
  url         String
  headers     Json       @default("[]")
  queryParams Json       @default("[]")
  bodyType    ApiBodyType @default(NONE)
  body        String?
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  assertions ApiAssertion[]
  executions ApiRequestExecution[]

  @@index([projectId])
  @@map("api_requests")
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
  OPTIONS
}

enum ApiBodyType {
  NONE
  JSON
  TEXT
  FORM
}

model ApiAssertion {
  id           String         @id @default(cuid())
  apiRequestId String
  type         AssertionType
  jsonPath     String?
  expected     String
  createdAt    DateTime       @default(now())

  apiRequest ApiRequest @relation(fields: [apiRequestId], references: [id], onDelete: Cascade)

  @@index([apiRequestId])
  @@map("api_assertions")
}

enum AssertionType {
  STATUS_EQUALS
  BODY_CONTAINS
  JSON_PATH_EQUALS
}

model ApiRequestExecution {
  id              String          @id @default(cuid())
  apiRequestId    String
  projectId       String
  executedById    String
  requestSnapshot Json
  responseStatus  Int?
  responseHeaders Json?
  responseBody    String?
  responseTruncated Boolean       @default(false)
  durationMs      Int?
  error           String?
  assertionResults Json?
  result          ExecutionResult
  createdAt       DateTime        @default(now())

  apiRequest ApiRequest @relation(fields: [apiRequestId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executedBy User       @relation(fields: [executedById], references: [id], onDelete: Restrict)

  @@index([apiRequestId, createdAt])
  @@map("api_request_executions")
}

enum ExecutionResult {
  PASS
  FAIL
  ERROR
}

model AutomationScript {
  id               String       @id @default(cuid())
  projectId        String
  testCaseId       String?
  title            String
  code             String
  reviewStatus     ReviewStatus @default(DRAFT)
  isValid          Boolean?
  validationErrors String?
  aiGenerationId   String?
  createdById      String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCase     TestCase?     @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  createdBy    User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  aiGeneration AiGeneration? @relation(fields: [aiGenerationId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([testCaseId])
  @@map("automation_scripts")
}

// ─────────────────────────────────────────────────────────────
// Phase 8: Regression Tracking + Screenshot Comparison.
//
// Regression tracking: a TestRun is a checklist snapshot — "these test
// cases, checked against this build" — with a PASS/FAIL/BLOCKED/SKIPPED
// result recorded per test case. No automatic execution; a human records
// what they observed running the test manually or via the generated
// automation script, same manual-recording model as the rest of this app.
//
// Screenshot comparison: deliberately user-uploaded images only, diffed
// with pixelmatch — no live browser screenshot capture. Automatically
// capturing a screenshot would mean navigating a headless browser to a
// user-supplied URL server-side, which is real infrastructure and
// reopens the same class of "server acts on an arbitrary URL"
// consideration as Phase 6's SSRF guard, just for a heavier operation.
// Uploaded-image diffing delivers the actual "did the UI change" value
// without any of that — a legitimate future increment, not a gap here.
// ─────────────────────────────────────────────────────────────

model TestRun {
  id          String        @id @default(cuid())
  projectId   String
  name        String
  status      TestRunStatus @default(IN_PROGRESS)
  createdById String
  createdAt   DateTime      @default(now())
  completedAt DateTime?

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  results   TestRunResult[]

  @@index([projectId, createdAt])
  @@map("test_runs")
}

enum TestRunStatus {
  IN_PROGRESS
  COMPLETED
}

model TestRunResult {
  id           String              @id @default(cuid())
  testRunId    String
  testCaseId   String
  result       TestRunResultStatus @default(NOT_RUN)
  notes        String?
  executedById String?
  executedAt   DateTime?

  testRun    TestRun   @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCase   TestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  executedBy User?     @relation(fields: [executedById], references: [id], onDelete: SetNull)

  @@unique([testRunId, testCaseId])
  @@index([testRunId])
  @@map("test_run_results")
}

enum TestRunResultStatus {
  NOT_RUN
  PASS
  FAIL
  BLOCKED
  SKIPPED
}

model ScreenshotBaseline {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  image       Bytes
  width       Int
  height      Int
  createdById String
  createdAt   DateTime @default(now())

  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User                   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  comparisons ScreenshotComparison[]

  @@index([projectId])
  @@map("screenshot_baselines")
}

model ScreenshotComparison {
  id             String                     @id @default(cuid())
  baselineId     String
  projectId      String
  candidateImage Bytes
  diffImage      Bytes?
  diffPixelCount Int?
  diffPercentage Float?
  threshold      Float                      @default(1.0)
  result         ScreenshotComparisonResult
  error          String?
  createdById    String
  createdAt      DateTime                   @default(now())

  baseline  ScreenshotBaseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User               @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([baselineId, createdAt])
  @@map("screenshot_comparisons")
}

enum ScreenshotComparisonResult {
  PASS
  FAIL
  ERROR
}
